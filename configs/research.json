{
  "experiment": "sentimix_custom_split_v1",
  "data_dir": "data/raw/hinglish_24k_sources/sentimix",
  "prepared_dir": "data/research/sentimix_custom_split_v1",
  "output_dir": "outputs/sentimix_custom_split_v1",
  "split_seed": 42,
  "test_fraction": 0.1,
  "validation_fraction": 0.1,
  "lowercase": false,
  "selection_metric": "weighted_f1",
  "bootstrap_samples": 1000,
  "baseline": {
    "max_features": 60000,
    "ngram_range": [1, 2],
    "min_df": 2,
    "nb_alpha": [0.1, 0.5, 1.0],
    "svm_c": [0.5, 1.0, 2.0]
  },
  "transformer": {
    "model_name": "bert-base-multilingual-cased",
    "revision": "main",
    "epochs": 3,
    "batch_size": 4,
    "gradient_accumulation_steps": 2,
    "eval_batch_size": 16,
    "max_length": 128,
    "learning_rate": 0.00002,
    "weight_decay": 0.01,
    "warmup_steps": 500,
    "gradient_checkpointing": true,
    "mixed_precision": true,
    "num_workers": 0,
    "log_every_steps": 100
  }
}
